PORT=443
# Port the backend runs on.

MONGO="mongodb://localhost:27017/bettercore"
# MongoDB database connection string.

MAINTENANCE=false
# Enables/disables backend maintenance mode.

BOT_TOKEN="YOUR_BOT_TOKEN"
# Discord bot token. Get it from Discord Developer Portal > Applications > Your App > Bot > Token.

ENABLE_LOGGING=true
# Enables console and backend logging.

## Ingame Options
SECTIONS="Better Core Bundle"
# Shop sections/categories that will appear in the item shop.
ENABLE_SHOP=true
# Enables or disables the in-game item shop.
WEEKLY=false # Unfinished, SHOULD work on seasons: S6, S7, S8, S9, S13

# Support a Creator
CREATORS="Akyi, Chad"
# Available Support-A-Creator codes.
